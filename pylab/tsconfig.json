{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "@components/*": ["components/*"],
      "@lib/*": ["lib/*"],
      "@storage/*": ["storage/*"],
      "@palette/*": ["palette/*"],
      "@workers/*": ["workers/*"],
      "@playground/*": ["playground/*"]
    },
    "types": []
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
